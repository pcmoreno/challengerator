<h1>Car Dashboard for {{ challengeName }}</h1>
<b><a href="{{ path('addVoterToChallengeFormPage', {'challengeName': challengeName, 'token': token }) }}">go to voters</a></b>
<div style="alignment: center; font-family: 'Arial Narrow',monospace; text-align: center; margin-left: auto; margin-right: auto">
    for now, only images from google-drive are accepted. Right click on the image, click 'get link' and then copy the part between the 'd/' and '/view'
</div>
<div class="formcontainer">
    {{ form(form) }}
</div>
<br>
<table>
    <tr><td>NAME</td><td>rating</td><td>ImageUrlA</td><td>ImageUrlB</td><td>Id</td></tr>
    {% for item in allCarsInChallenge | sort((a,b) => b.rating.rating() <=> a.rating.rating())%}
        <tr><td>{{ item.name }}</td><td>{{ item.rating.rating() }}</td><td>{{ item.imageUrlA }}</td><td>{{ item.imageUrlB }}</td><td>{{ item.id }}</td></tr>
    {% endfor %}
</table>

<div class="formcontainer">
{{ form(adminDeleteCarForm) }}
</div>

{% include 'default/generalStyle.html.twig' %}
