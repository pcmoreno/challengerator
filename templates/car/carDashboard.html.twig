{% extends 'base.html.twig' %}

{% block title %}Car Dashboard | {{ challengeDisplayName }}{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-heading">Car Dashboard — {{ challengeDisplayName }}</h2>
        <div class="flex gap-4 text-sm">
            <a href="{{ path('addVoterToChallengeFormPage', {'challengeName': challengeName}) }}"
               class="text-link hover:underline font-semibold">→ Voters</a>
        </div>
    </div>

    <div class="mb-4 p-4 rounded-lg border {{ driveConnected ? 'bg-green-50 border-green-200' : 'bg-yellow-50 border-yellow-200' }}">
        {% if driveConnected %}
            <span class="font-semibold text-green-800">Google Drive connected</span>
            {% if driveEmail %} — <span class="text-gray-600 text-sm">{{ driveEmail }}</span>{% endif %}
            <form method="post"
                  action="{{ path('drive_oauth_disconnect', {'challengeName': challengeName}) }}"
                  class="inline ml-4">
                <input type="hidden" name="_token" value="{{ csrf_token('drive_disconnect_' ~ challengeName) }}">
                <button type="submit" class="text-red-600 hover:underline text-xs">Disconnect</button>
            </form>
        {% else %}
            <span class="font-semibold text-yellow-800">Google Drive not connected.</span>
            <a href="{{ path('drive_oauth_connect', {'challengeName': challengeName}) }}"
               class="ml-2 text-blue-700 hover:underline font-semibold">Connect Google Drive →</a>
        {% endif %}
    </div>

    <div class="bg-panel rounded-lg shadow p-6 mb-6">
        {% if driveConnected %}
            {{ form(form) }}
        {% else %}
            <div class="opacity-50 p-6 text-center text-gray-400 border rounded-lg">
                Connect Google Drive to add cars.
            </div>
        {% endif %}
    </div>

    <div class="bg-surface rounded-lg shadow overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-panel text-white text-xs uppercase tracking-wider">
                    <th class="px-3 py-2 text-left">Name</th>
                    <th class="px-3 py-2 text-left">Rating</th>
                    <th class="px-3 py-2 text-left">Image A</th>
                    <th class="px-3 py-2 text-left">Image B</th>
                    <th class="px-3 py-2"></th>
                </tr>
            </thead>
            <tbody>
                {% for item in allCarsInChallenge | sort((a,b) => b.rating.rating() <=> a.rating.rating()) %}
                    <tr class="border-t {{ loop.index is even ? 'bg-row-even' : 'bg-row-odd' }}">
                        <td class="px-3 py-2">{{ item.name }}</td>
                        <td class="px-3 py-2">{{ item.rating.rating() }}</td>
                        <td class="px-3 py-2 font-mono text-xs truncate max-w-xs">{{ item.imageUrlA }}</td>
                        <td class="px-3 py-2 font-mono text-xs truncate max-w-xs">{{ item.imageUrlB }}</td>
                        <td class="px-3 py-2 text-right">
                            <form method="post"
                                  action="{{ path('deleteCar', {challengeName: challengeName, carId: item.id}) }}"
                                  data-turbo-confirm="Delete {{ item.name }}? This cannot be undone.">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_car_' ~ item.id) }}">
                                <button type="submit" class="text-gray-500 hover:text-red-500 transition cursor-pointer" aria-label="Delete car">
                                    {% include 'icons/trash.html.twig' %}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
