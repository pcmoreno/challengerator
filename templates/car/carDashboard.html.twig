{% extends 'base.html.twig' %}

{% block title %}Car Dashboard | {{ challengeName }}{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-heading">Car Dashboard — {{ challengeName }}</h2>
        <div class="flex gap-4 text-sm">
            <a href="{{ path('addVoterToChallengeFormPage', {'challengeName': challengeName}) }}"
               class="text-link hover:underline font-semibold">→ Voters</a>
            <a href="{{ path('uploadFile') }}" target="_blank"
               class="text-link hover:underline font-semibold">→ Upload Images</a>
        </div>
    </div>

    <p class="text-sm text-muted mb-4">
        Only Google Drive images are supported. Right-click image → Get Link → copy the ID between
        <code class="bg-gray-100 px-1 rounded">d/</code> and <code class="bg-gray-100 px-1 rounded">/view</code>.
    </p>

    <div class="bg-panel rounded-lg shadow p-6 mb-6">
        {{ form(form) }}
    </div>

    <div class="bg-surface rounded-lg shadow overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-panel text-white text-xs uppercase tracking-wider">
                    <th class="px-3 py-2 text-left">Name</th>
                    <th class="px-3 py-2 text-left">Rating</th>
                    <th class="px-3 py-2 text-left">Image A</th>
                    <th class="px-3 py-2 text-left">Image B</th>
                    <th class="px-3 py-2 text-left">ID</th>
                </tr>
            </thead>
            <tbody>
                {% for item in allCarsInChallenge | sort((a,b) => b.rating.rating() <=> a.rating.rating()) %}
                    <tr class="border-t {{ loop.index is even ? 'bg-row-even' : 'bg-row-odd' }}">
                        <td class="px-3 py-2">{{ item.name }}</td>
                        <td class="px-3 py-2">{{ item.rating.rating() }}</td>
                        <td class="px-3 py-2 font-mono text-xs truncate max-w-xs">{{ item.imageUrlA }}</td>
                        <td class="px-3 py-2 font-mono text-xs truncate max-w-xs">{{ item.imageUrlB }}</td>
                        <td class="px-3 py-2 font-mono text-xs">{{ item.id }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="bg-panel rounded-lg shadow p-6">
        {{ form(adminDeleteCarForm) }}
    </div>
{% endblock %}
