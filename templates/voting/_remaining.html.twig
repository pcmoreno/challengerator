<div id="cars-remaining" class="bg-white rounded-lg shadow p-4">
    <h3 class="text-sm font-semibold text-gray-500 mb-2">
        Cars left to compare: {{ carsNotVoted|length }}
    </h3>
    {% if carsNotVoted is not empty %}
        <ul class="columns-2 text-sm text-gray-400 list-disc list-inside">
            {% for car in carsNotVoted %}
                <li>{{ car }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
