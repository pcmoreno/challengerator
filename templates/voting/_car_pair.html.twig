<div id="car-pair" data-controller="voting" class="bg-surface rounded-lg shadow p-6 mb-6">
    {% set isDev = app.request.server.get('APP_ENV') %}
    <div class="grid grid-cols-2 gap-8 mb-6">
        {% for item in carsToVote %}
            <div class="flex flex-col items-center gap-4">
                <h3 class="text-lg font-semibold text-center">{{ item.name }}</h3>
                {% if isDev == 'dev' %}
                    <span class="text-xs text-muted">Rating: {{ item.rating.rating() }}</span>
                {% endif %}
                <div class="space-y-2 w-full">
                    <img src="https://drive.google.com/thumbnail?sz=w600&id={{ item.imageUrlA }}" alt="{{ item.name }}"
                         class="rounded w-full object-cover" style="height:300px">
                    <img src="https://drive.google.com/thumbnail?sz=w600&id={{ item.imageUrlB }}" alt="{{ item.name }}"
                         class="rounded w-full object-cover" style="height:300px">
                </div>
                <form method="post"
                      action="{{ path('voteCarForUser', {'challengeName': challengeName}) }}"
                      data-turbo-stream>
                    <input type="hidden" name="cars" value="{{ carsToVote[0].id }}XXX{{ carsToVote[1].id }}">
                    <input type="hidden" name="result" value="{{ loop.first ? 'left' : 'right' }}">
                    <button type="submit"
                            class="btn-primary font-bold py-2 px-8 rounded">
                        THIS ONE
                    </button>
                </form>
            </div>
        {% endfor %}
    </div>

    <div class="text-center border-t pt-4">
        <form method="post"
              action="{{ path('voteCarForUser', {'challengeName': challengeName}) }}"
              data-turbo-stream>
            <input type="hidden" name="cars" value="{{ carsToVote[0].id }}XXX{{ carsToVote[1].id }}">
            <input type="hidden" name="result" value="draw">
            <button type="submit"
                    class="btn-secondary font-bold py-2 px-8 rounded">
                SAME QUALITY (Draw)
            </button>
        </form>
    </div>
</div>
