<h1>Voter Dashboard for {{ challengeName }}</h1>
<a href="{{ path('addCarToChallengeFormPage', {'challengeName': challengeName }) }}">go to cars</a>
<div class="formcontainer">
{{ form(form) }}
</div>

    <br>
    <h3>Users in this challenge</h3>
    <table>
        {% block topRow %}
        <td>NAME</td><td>#comparisons made</td><td>ID</td>
        {% endblock %}
        {% for voter in allUsersInTheChallenge %}
            <tr>
                <td>{{ voter.name }}</td>
                <td>{{ voter.countComparisonsMadeForChallenge(challengeName) }}</td>
                <td>{{ voter.id }}</td>
            </tr>
        {% endfor %}
    </table>
    <br><br>

<div class="formcontainer">
{{ form(adminDeleteForm) }}
</div>

{% include 'default/generalStyle.html.twig' %}

