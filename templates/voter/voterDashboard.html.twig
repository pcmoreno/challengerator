{% extends 'base.html.twig' %}

{% block title %}Voter Dashboard | {{ challengeDisplayName }}{% endblock %}

{% block body %}
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-heading">Voter Dashboard — {{ challengeDisplayName }}</h2>
        <a href="{{ path('addCarToChallengeFormPage', {'challengeName': challengeName}) }}"
           class="text-link hover:underline font-semibold text-sm">→ Cars</a>
    </div>

    <div class="bg-panel rounded-lg shadow p-6 mb-6">
        {{ form(form) }}
    </div>

    <div class="mb-4 flex flex-wrap items-center gap-3">
        <h3 class="font-semibold text-muted">
            Users in this challenge
            <span class="font-normal ml-1">
                (self registration is <span class="text-purple-500 font-semibold">{{ selfRegistration }}</span>)
            </span>
        </h3>
        <form method="post" action="{{ path('toggleSelfRegistrationForChallenge', {'challengeName': challengeName}) }}" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_self_reg_' ~ challengeName) }}">
            <button type="submit" class="text-link hover:underline text-sm bg-transparent border-0 p-0 cursor-pointer">[toggle on/off]</button>
        </form>
        {% if selfRegistrationCode is defined and selfRegistration == 'active' %}
            <a href="{{ path('addSelfRegisteredVoterToChallengeFormPage', {'challengeName': challengeName, 'selfRegistrationCode': selfRegistrationCode}) }}"
               target="_blank" rel="noopener noreferrer"
               class="text-red-500 hover:underline text-sm font-semibold">[link for voter]</a>
        {% endif %}
    </div>

    <div class="bg-surface rounded-lg shadow overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-panel text-white text-xs uppercase tracking-wider">
                    <th class="px-3 py-2 text-left">Name</th>
                    <th class="px-3 py-2 text-left">Comparisons</th>
                    <th class="px-3 py-2 text-left">Cars Left</th>
                    <th class="px-3 py-2 text-left">ID</th>
                    <th class="px-3 py-2 text-left">IP</th>
                    <th class="px-3 py-2"></th>
                </tr>
            </thead>
            <tbody>
                {% for voter in allUsersInTheChallenge %}
                    <tr class="border-t {{ loop.index is even ? 'bg-row-even' : 'bg-row-odd' }}">
                        <td class="px-3 py-2">{{ voter.name }}</td>
                        <td class="px-3 py-2">
                            {% if voter.comparisons == 'Exception' %}
                                <span class="text-red-500 font-semibold">Exception</span>
                            {% else %}
                                {{ voter.comparisons }}
                            {% endif %}
                        </td>
                        <td class="px-3 py-2">{{ voter.carsLeft }}</td>
                        <td class="px-3 py-2 font-mono text-xs">{{ voter.id }}</td>
                        <td class="px-3 py-2 font-mono text-xs text-muted">{{ voter.ipAddress }}</td>
                        <td class="px-3 py-2">
                            <form method="post" action="{{ path('resetVotesForVoterOnChallenge') }}">
                                <input type="hidden" name="challengeName" value="{{ challengeName }}">
                                <input type="hidden" name="voterId" value="{{ voter.id }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('reset_voter_' ~ voter.id) }}">
                                <button type="submit" class="text-link hover:underline text-xs bg-transparent border-0 p-0 cursor-pointer">
                                    give more votes
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="bg-panel rounded-lg shadow p-6 mb-6">
        {{ form(adminDeleteForm) }}
    </div>

    <div class="text-center">
        <form method="post" action="{{ path('startChallenge', {'challengeName': challengeName}) }}"
              data-turbo-confirm="Everyone will be able to vote again. Continue?">
            <input type="hidden" name="_token" value="{{ csrf_token('start_challenge_' ~ challengeName) }}">
            <button type="submit"
                    class="btn-primary font-bold py-2 px-8 rounded">
                Open Challenge
            </button>
        </form>
    </div>

    <section class="mt-10">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <h3 class="font-semibold text-muted text-lg">Vote log</h3>
            <div class="flex items-center gap-3">
                <a href="{{ path('exportVotesCsv', {
                    'challengeName': challengeName,
                    'voterId': voteLogFilters.voterId,
                    'carId': voteLogFilters.carId,
                    'status': voteLogFilters.status
                }) }}"
                   class="text-link hover:underline text-sm">Export CSV</a>
                <form method="post"
                      action="{{ path('recalculateRatings', {'challengeName': challengeName}) }}"
                      data-turbo-confirm="This rewrites every car's rating from scratch based on the valid votes in the log. Continue?"
                      class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('recalc_ratings_' ~ challengeName) }}">
                    <button type="submit" class="btn-primary text-sm font-semibold py-1.5 px-4 rounded">
                        Recalculate ratings
                    </button>
                </form>
            </div>
        </div>

        <form method="get"
              action="{{ path('addVoterToChallengeFormPage', {'challengeName': challengeName}) }}"
              class="bg-panel rounded-lg shadow p-4 mb-4 flex flex-wrap items-end gap-3 text-sm">
            <label class="flex flex-col">
                <span class="text-muted text-xs mb-1">Voter</span>
                <select name="voterId" class="bg-surface text-sm rounded border border-gray-700 px-2 py-1">
                    <option value="">All voters</option>
                    {% for voter in allUsersInTheChallenge %}
                        <option value="{{ voter.id }}" {{ voteLogFilters.voterId == voter.id ? 'selected' : '' }}>
                            {{ voter.name }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            <label class="flex flex-col">
                <span class="text-muted text-xs mb-1">Car</span>
                <select name="carId" class="bg-surface text-sm rounded border border-gray-700 px-2 py-1">
                    <option value="">All cars</option>
                    {% for car in carsForFilter %}
                        <option value="{{ car.id }}" {{ voteLogFilters.carId == car.id ? 'selected' : '' }}>
                            {{ car.name }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            <label class="flex flex-col">
                <span class="text-muted text-xs mb-1">Status</span>
                <select name="status" class="bg-surface text-sm rounded border border-gray-700 px-2 py-1">
                    <option value="">Any</option>
                    <option value="valid" {{ voteLogFilters.status == 'valid' ? 'selected' : '' }}>Valid</option>
                    <option value="invalidated" {{ voteLogFilters.status == 'invalidated' ? 'selected' : '' }}>Invalidated</option>
                </select>
            </label>
            <button type="submit" class="btn-primary text-sm font-semibold py-1.5 px-4 rounded">Apply</button>
            <a href="{{ path('addVoterToChallengeFormPage', {'challengeName': challengeName}) }}"
               class="text-link hover:underline text-sm">Clear</a>
        </form>

        <div class="bg-surface rounded-lg shadow overflow-hidden">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-panel text-white text-xs uppercase tracking-wider">
                        <th class="px-3 py-2 text-left">Time</th>
                        <th class="px-3 py-2 text-left">Voter</th>
                        <th class="px-3 py-2 text-left">Car A</th>
                        <th class="px-3 py-2 text-left">Car B</th>
                        <th class="px-3 py-2 text-right">Rating A</th>
                        <th class="px-3 py-2 text-right">Rating B</th>
                        <th class="px-3 py-2 text-left">Outcome</th>
                        <th class="px-3 py-2 text-left">Status</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in voteLogPage.entries %}
                        <tr class="border-t {{ loop.index is even ? 'bg-row-even' : 'bg-row-odd' }}">
                            <td class="px-3 py-2 font-mono text-xs whitespace-nowrap">
                                {{ entry.votedAt|date('Y-m-d H:i:s') }}
                            </td>
                            <td class="px-3 py-2">{{ entry.voterName }}</td>
                            <td class="px-3 py-2">{{ entry.carAName }}</td>
                            <td class="px-3 py-2">{{ entry.carBName }}</td>
                            <td class="px-3 py-2 text-right font-mono">{{ entry.carARatingBefore }}</td>
                            <td class="px-3 py-2 text-right font-mono">{{ entry.carBRatingBefore }}</td>
                            <td class="px-3 py-2">
                                {% if entry.outcome == 'left' %}A wins
                                {% elseif entry.outcome == 'right' %}B wins
                                {% else %}Draw{% endif %}
                            </td>
                            <td class="px-3 py-2">
                                {% if entry.status == 'valid' %}
                                    <span class="text-green-500 font-semibold">valid</span>
                                {% else %}
                                    <span class="text-red-500 font-semibold">invalidated</span>
                                    {% if entry.invalidatedBy %}
                                        <div class="text-muted text-xs">by {{ entry.invalidatedBy }}{% if entry.invalidatedAt %} on {{ entry.invalidatedAt|date('Y-m-d H:i') }}{% endif %}</div>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="px-3 py-2">
                                {% if entry.status == 'valid' %}
                                    <form method="post"
                                          action="{{ path('invalidateVote', {'challengeName': challengeName, 'voteId': entry.voteId}) }}"
                                          data-turbo-confirm="Invalidate this vote?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('invalidate_vote_' ~ entry.voteId) }}">
                                        <button type="submit" class="text-link hover:underline text-xs bg-transparent border-0 p-0 cursor-pointer">
                                            invalidate
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="px-3 py-6 text-center text-muted">No votes recorded yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3 flex items-center justify-between text-sm">
            <div class="text-muted">
                {% if voteLogPage.entries|length > 0 %}
                    Showing {{ voteLogPage.offset + 1 }}–{{ voteLogPage.offset + voteLogPage.entries|length }}
                {% endif %}
            </div>
            <div class="flex gap-3">
                {% if voteLogPage.previousOffset is not null %}
                    <a class="text-link hover:underline"
                       href="{{ path('addVoterToChallengeFormPage', {
                           'challengeName': challengeName,
                           'voterId': voteLogFilters.voterId,
                           'carId': voteLogFilters.carId,
                           'status': voteLogFilters.status,
                           'offset': voteLogPage.previousOffset
                       }) }}">← Previous</a>
                {% endif %}
                {% if voteLogPage.nextOffset is not null %}
                    <a class="text-link hover:underline"
                       href="{{ path('addVoterToChallengeFormPage', {
                           'challengeName': challengeName,
                           'voterId': voteLogFilters.voterId,
                           'carId': voteLogFilters.carId,
                           'status': voteLogFilters.status,
                           'offset': voteLogPage.nextOffset
                       }) }}">Next →</a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
