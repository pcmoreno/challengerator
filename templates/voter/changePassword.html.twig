{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto mt-8">
        <h2 class="text-2xl font-bold text-center text-heading mb-6">Change Password</h2>
        <div class="bg-panel rounded-lg shadow p-6">
            {{ form(changePasswordForm) }}
        </div>
        {% if message is defined and message %}
            <p class="text-center text-red-500 mt-4 font-semibold">{{ message }}</p>
        {% endif %}
    </div>
{% endblock %}
