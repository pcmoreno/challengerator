<h1>Dashboard for {{ challengeName }}</h1>
<div class="formcontainer">
{{ form(form) }}
</div>

    <br>
    <h3>Users in this challenge</h3>
    <table>
        {% block topRow %}
        <td>NAME</td><td>HASHKEY</td><td>ID</td>
        {% endblock %}
        {% for voter in allUsersInTheChallenge %}
            <tr>
                <td>{{ voter.name }}</td>
                <td>{{ voter.authKey }}</td>
                <td>{{ voter.id }}</td>
            </tr>
        {% endfor %}
    </table>
    <br><br>

<div class="formcontainer">
{{ form(adminDeleteForm) }}
</div>

{% include 'default/generalStyle.html.twig' %}

