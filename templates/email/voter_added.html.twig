<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>You've been added to {{ challengeDisplayName }}</title>
</head>
<body style="margin:0;padding:0;background-color:#171717;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" role="presentation"
       style="background-color:#171717;">
    <tr>
        <td align="center" style="padding:40px 20px;">

            <table width="600" cellpadding="0" cellspacing="0" role="presentation"
                   style="max-width:600px;width:100%;background-color:#1d1b1b;border-radius:8px;overflow:hidden;">

                {# ── Header ── #}
                <tr>
                    <td style="background-color:#1f1f1f;padding:24px 32px;">
                        <span style="color:#ffffff;font-size:22px;font-weight:bold;letter-spacing:3px;text-transform:uppercase;">
                            CHALLENGERATOR
                        </span>
                    </td>
                </tr>

                {# ── Body ── #}
                <tr>
                    <td style="padding:36px 32px;">

                        <h1 style="margin:0 0 8px 0;color:#ffffff;font-size:26px;font-weight:bold;">
                            You've been added!
                        </h1>
                        <p style="margin:0 0 24px 0;color:#999999;font-size:14px;text-transform:uppercase;letter-spacing:1px;">
                            Car design challenge
                        </p>

                        <p style="margin:0 0 4px 0;color:#dadada;font-size:16px;line-height:1.6;">
                            You have been added to
                            <strong style="color:#ff8b38;">{{ challengeDisplayName }}</strong>
                            — a head-to-head car design voting competition.
                            Log in with your existing account to start voting.
                        </p>
                        <p style="margin:0 0 32px 0;color:#666666;font-size:13px;">
                            Challenge ID: <span style="color:#999999;">{{ challengeName }}</span>
                        </p>

                        {# ── CTA Button ── #}
                        <table cellpadding="0" cellspacing="0" role="presentation" style="margin-bottom:32px;">
                            <tr>
                                <td style="background-color:#ff8b38;border-radius:4px;">
                                    <a href="{{ loginUrl }}"
                                       style="display:inline-block;padding:14px 36px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:16px;">
                                        Go to {{ challengeDisplayName }}
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0;color:#666666;font-size:12px;">
                            If you did not expect this email, you can safely ignore it.
                        </p>

                    </td>
                </tr>

                {# ── Footer ── #}
                <tr>
                    <td style="background-color:#1f1f1f;padding:16px 32px;text-align:center;">
                        <span style="color:#555555;font-size:12px;">
                            &copy; {{ "now"|date("Y") }} Challengerator
                        </span>
                    </td>
                </tr>

            </table>

        </td>
    </tr>
</table>

</body>
</html>
