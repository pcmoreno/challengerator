{% extends 'base.html.twig' %}

{% block title %}Login | Challengerator{% endblock %}

{% block head %}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto mt-12 space-y-6">

        <div class="text-center space-y-1">
            <img src="{{ asset('favicon.svg') }}" alt="" class="w-14 h-14 mx-auto opacity-90">
            <h1 class="text-2xl font-bold text-heading">Sign in</h1>
        </div>

        <div data-controller="login" class="bg-surface rounded-xl shadow overflow-hidden">

            {# Tab strip #}
            <div class="flex border-b border-subtle">
                <button type="button"
                        data-login-target="userTab"
                        data-action="click->login#showUser"
                        class="flex-1 py-3 text-sm font-semibold bg-panel text-white transition-colors cursor-pointer border-0">
                    Login
                </button>
                <button type="button"
                        data-login-target="adminTab"
                        data-action="click->login#showAdmin"
                        class="flex-1 py-3 text-sm font-semibold text-muted transition-colors cursor-pointer border-0 bg-transparent">
                    Challenge Admin
                </button>
            </div>

            {# User login panel #}
            <div data-login-target="userPanel" class="p-6 space-y-4">
                <form method="POST" action="{{ path('voter_login') }}" data-controller="voting">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="space-y-3">
                        <input type="text" name="login[user]"
                               placeholder="Username" required autocomplete="username"
                               class="w-full px-3 py-2 border border-subtle rounded-lg bg-panel text-body placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-link">
                        <input type="password" name="login[pass]"
                               placeholder="Password" required autocomplete="current-password"
                               class="w-full px-3 py-2 border border-subtle rounded-lg bg-panel text-body placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-link">
                    </div>
                    <button type="submit"
                            class="btn-primary w-full font-bold py-2 rounded-lg mt-4">
                        Login
                    </button>
                </form>
            </div>

            {# Admin login panel #}
            <div data-login-target="adminPanel" class="p-6 space-y-4 hidden">
                <form method="POST" action="{{ path('admin_login') }}" data-controller="voting">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_login') }}">
                    <div class="space-y-3">
                        <input type="text" name="challenge_slug"
                               placeholder="Challenge slug" required autocomplete="off"
                               class="w-full px-3 py-2 border border-subtle rounded-lg bg-panel text-body placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-link">
                        <input type="password" name="admin_pass"
                               placeholder="Admin password" required autocomplete="current-password"
                               class="w-full px-3 py-2 border border-subtle rounded-lg bg-panel text-body placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-link">
                    </div>
                    <button type="submit"
                            class="btn-primary w-full font-bold py-2 rounded-lg mt-4">
                        Login as Admin
                    </button>
                </form>
            </div>

        </div>

    </div>
{% endblock %}
