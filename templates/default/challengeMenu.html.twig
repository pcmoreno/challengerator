{% extends 'base.html.twig' %}

{% block title %}Challenges{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-heading mb-6">Ongoing Challenges</h2>

        {% if challenges is empty %}
            <div class="text-center py-12 bg-surface rounded-lg shadow">
                <p class="text-muted text-lg">No challenges available at the moment.</p>
            </div>
        {% else %}
            <div class="bg-surface rounded-lg shadow overflow-hidden">
                <table class="w-full">
                    <thead>
                        <tr class="bg-panel text-white text-xs uppercase tracking-wider">
                            <th class="px-4 py-3 text-left">Challenge</th>
                            <th class="px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in challenges %}
                            <tr class="border-t {{ loop.index is even ? 'bg-row-even' : 'bg-row-odd' }}">
                                <td class="px-4 py-3">
                                    {{ item.displayName }}
                                    <span class="text-xs text-muted ml-1">({{ item.name }})</span>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <a href="{{ path('loginMenu', {'challengeName': item.name}) }}"
                                       class="btn-primary font-bold py-1 px-4 rounded text-sm">
                                        GO TO
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <div class="text-center mt-6">
            <a href="{{ path('index') }}" class="text-link hover:underline text-sm">← Back</a>
        </div>
    </div>
{% endblock %}
