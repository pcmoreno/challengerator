{% extends 'base.html.twig' %}

{% block title %}Create Challenge{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto mt-8">
        <h2 class="text-2xl font-bold text-center text-green-800 mb-6">Create New Challenge</h2>
        <div class="bg-blue-400 rounded-lg shadow p-6">
            {{ form_start(adminCreateChallengeForm, {'attr': {'class': 'space-y-4'}}) }}
                {{ form_row(adminCreateChallengeForm.challengeName) }}
                {{ form_row(adminCreateChallengeForm.adminPass) }}
                {{ form_row(adminCreateChallengeForm.creationToken) }}
                {{ form_row(adminCreateChallengeForm.create) }}
            {{ form_end(adminCreateChallengeForm) }}
        </div>
        <p class="text-center text-gray-600 text-sm mt-4">
            Challenge name must be lowercase with no spaces.
        </p>
        <div class="text-center mt-4">
            <a href="{{ path('index') }}" class="text-blue-700 hover:underline text-sm">← Back</a>
        </div>
    </div>
{% endblock %}
