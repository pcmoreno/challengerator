<h1>Create new Challenge</h1><br>

{% include 'default/generalStyle.html.twig' %}

<style>
    form {
        margin: auto;
        width: 50%;
    }
</style>

<div class="formcontainer">
    {{ form_start(adminCreateChallengeForm) }}
    {{ form_row(adminCreateChallengeForm.challengeName) }}
    {{ form_row(adminCreateChallengeForm.adminPass) }}
    {{ form_row(adminCreateChallengeForm.creationToken) }}
    {{ form_row(adminCreateChallengeForm.login) }}
    <div class="cap" style="alignment: center; width: 160px; margin-left: auto; margin-right: auto">
        {{ form_widget(adminCreateChallengeForm.captcha) }}
    </div>

    {{ form_end(adminCreateChallengeForm) }}

{#    {{ form(adminCreateChallengeForm) }}#}
</div>