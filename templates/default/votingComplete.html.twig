{% extends 'base.html.twig' %}

{% block title %}Voting Complete | {{ challengeDisplayName }}{% endblock %}

{% block body %}
    <div class="max-w-lg mx-auto mt-12">
        <div class="bg-surface rounded-lg shadow p-8 text-center">
            <h2 class="text-2xl font-bold text-heading mb-4">Thank you for voting!</h2>
            <p class="text-muted mb-2">There are no more cars left to compare.</p>
            <p class="text-muted mb-6">
                You can ask your admin at <strong>{{ challengeDisplayName }}</strong> to give you another round of comparisons.
            </p>
            <a href="{{ path('listChallengesMenu') }}"
               class="btn-primary inline-block font-bold py-2 px-6 rounded">
                My Challenges
            </a>
        </div>
    </div>
{% endblock %}
