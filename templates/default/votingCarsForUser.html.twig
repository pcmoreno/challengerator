{% extends 'base.html.twig' %}

{% block head %}
    <meta charset="UTF-8"/>
    <title>{% block title %}Challenge Car Index{% endblock %}</title>
{% endblock %}

{% block body %}
    <table>
        <tr>
            {% set isDev = app.request.server.get('APP_ENV')  %}
            <td>Car name</td>
            {% if  (isDev == 'dev') %}
            <td>rating</td>
            {% endif %}
            <td>Your vote</td>
        </tr>
        {% set turn = 'left' %}
        {% for item in carsToVote %}
            <tr>
                <td>{{ item.name }}</td>
                {% if  (isDev == 'dev') %}
                <td>{{ item.rating }}</td>
                {% endif %}
                <td>
                    <button><a href= {{ path('voteCarForUser', {
                            'challengeName': challengeName,
                            'userId': user,
                            'cars': "#{carsToVote[0]['_id']}XXX#{carsToVote[1]['_id']}",
                            'result': turn,
                            'token': token
                        }) }}>THIS ONE</a></button>
                </td>
                <td><img class="article-img" src="https://drive.google.com/uc?id={{ item.imageUrlA }}"
                         alt="{{ item.name }}" height="450" width="800"></td>
                <td><img class="article-img" src="https://drive.google.com/uc?id={{ item.imageUrlB }}"
                         alt="{{ item.name }}" height="450" width="800"></td>
            </tr>
            {% set turn = 'right' %}
        {% endfor %}
        <tr>
            <td></td>
            <td></td>
            <td>
                <button style="white-space: normal"><a href= {{ path('voteCarForUser', {
                        'challengeName': challengeName,
                        'userId': user,
                        'cars': "#{carsToVote[0]['_id']}XXX#{carsToVote[1]['_id']}",
                        'result': 'draw',
                        'token': token
                    }) }}>SAME QUALITY</a></button>
            </td>
        </tr>
    </table>
    <table class="listOfCarsLeft">
        <tr><td>cars left to be voted</td></tr>
        {% for item in carsNotVoted %}
            <tr>
                <td>{{ item }}</td>
            </tr>
        {% endfor %}
    </table>
    {% include 'default/generalStyle.html.twig' %}

    <style>
        table.listOfCarsLeft {
            width: 50%;
        }
    </style>
{% endblock %}
